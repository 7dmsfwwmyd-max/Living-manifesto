{
  "name": "living-manifesto-app",
  "main": "dist/_worker.js",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "dist",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "living-manifesto",
      "database_id": "39259550-5d35-4d51-aaee-f203d33af1c9"
    }
  ],
  "ai": {
    "binding": "CONVERTER"
  },
  "unsafe": { "bindings": [{ "name": "AI", "type": "ai" }] },
  "build": {
    "command": "node deploy.mjs && printf '_worker.js\\n_headers\\n' > dist/.assetsignore"
  }
}
